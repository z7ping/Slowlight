# Slowlight 服务端环境变量模板
# 复制为 server/.env 或在运行环境中注入；不要提交真实密钥。

# PostgreSQL DSN（必填）
DATABASE_URL=host=127.0.0.1 user=slowlight password=change_me dbname=slowlight port=5432 sslmode=disable TimeZone=Asia/Shanghai

# 服务端口（可选，默认 8080）
PORT=8080

# JWT 签名密钥（必填）
JWT_SECRET=change_me_to_a_long_random_secret

# 集成凭据静态加密密钥（必填，至少 32 个字符；生产环境请使用独立随机值）
CONFIG_ENCRYPTION_KEY=change_me_to_an_independent_32_char_secret

# CORS 白名单（可选，逗号分隔；生产环境建议显式配置）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# 后端集成测试数据库（运行依赖 PostgreSQL 的测试时使用）
TEST_DATABASE_URL=host=127.0.0.1 user=slowlight password=change_me dbname=slowlight_test port=5432 sslmode=disable TimeZone=Asia/Shanghai
